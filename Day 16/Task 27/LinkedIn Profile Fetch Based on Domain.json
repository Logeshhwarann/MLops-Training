{
  "name": "LinkedIn Profile Fetch Based on Domain",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst place =\n  item.Place ||\n  item.place ||\n  '';\n\nconst role =\n  item.Role ||\n  item.role ||\n  '';\n\nif (!place || !role) {\n  throw new Error(\n    'Place and Role are required. Input received: ' +\n    JSON.stringify(item)\n  );\n}\n\nreturn [{\n  json: {\n    place: place.trim(),\n    role: role.trim(),\n    searchQuery: `site:linkedin.com/in \"${role}\" \"${place}\"`,\n    submittedAt: item.submittedAt || new Date().toISOString()\n  }\n}];"
      },
      "id": "3e9736fc-df3a-4987-ad7f-0f6c7a10dcb9",
      "name": "Extract & Clean Domain",
      "type": "n8n-nodes-base.code",
