      "id": "c373a80d-b1cb-4b57-b893-5043ef2e7426",
      "name": "Hunter.io - Find Emails by Domain (FREE)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -128,
        48
      ],
      "notes": "FREE: Hunter.io gives 25 free searches/month. Sign up at hunter.io and get your free API key. Set it as credential: hunterApiKey"
    },
    {
      "parameters": {
        "jsCode": "const domain = $('Extract & Clean Domain').first().json.domain;\n\nconst hunterData =\n  $('Hunter.io - Find Emails by Domain (FREE)').first().json;\n\nconst hunterEmails =\n  hunterData?.data?.emails || [];\n\nif (hunterEmails.length === 0) {\n  return [{\n    json: {\n      domain,\n      message: 'No profiles found',\n      fetched_at: new Date().toISOString()\n    }\n  }];\n}\n\nreturn hunterEmails.map(e => ({\n  json: {\n    domain,\n    name: [e.first_name, e.last_name].filter(Boolean).join(' '),\n    email: e.value || null,\n    position: e.position || null,\n    seniority: e.seniority || null,\n    department: e.department || null,\n    linkedin_url: e.linkedin || null,\n    twitter: e.twitter || null,\n    phone: e.phone_number || null,\n    confidence: e.confidence || null,\n    source: 'Hunter.io',\n    fetched_at: new Date().toISOString()\n  }\n}));"
      },
